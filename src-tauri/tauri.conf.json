{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BundleRock",
  "version": "0.2.5",
  "identifier": "com.bundlerock.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BundleRock",
        "width": 1024,
        "height": 680,
        "minWidth": 800,
        "minHeight": 520,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGMUVCQkJERjEyMzI0MDcKUldRSEpDUHh2YnNlNzlqcE5RUlF5eTZ0azU1bUUxUUZHVW01VFJUWTRvSW5zYldCeGVQYjZGc2sK",
      "endpoints": [
        "https://github.com/Franz2308/bundlerock/releases/latest/download/latest.json"
      ]
    }
  }
}
